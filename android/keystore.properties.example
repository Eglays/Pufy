# Pufy Android Release Keystore Yapılandırma Örneği
# Bu dosyayı 'keystore.properties' olarak kopyalayıp kendi bilgilerinizi girin.
# GÜVENLİK UYARISI: keystore.properties ve .jks anahtar dosyası asla git/depoya eklenmemeli ve paylaşılmamalıdır!

storeFile=release.jks
storePassword=KEYSTORE_SIFRESI
keyAlias=pufy
keyPassword=ANAHTAR_SIFRESI
