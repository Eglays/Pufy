            "state": "translated",
            "value": "APPS"
          }
        }
      }
    },
    "Ekranın sağ kenarından ortaya doğru çek ya da iki parmakla kıstır. Ne istediğini anlat, Pufy senin için bir uygulama ya da oyun yazsın.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekranın sağ kenarından ortaya doğru çek ya da iki parmakla kıstır. Ne istediğini anlat, Pufy senin için bir uygulama ya da oyun yazsın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe from the right edge or pinch with two fingers. Tell Pufy what you want, and it will build an app or game for you."
          }
        }
      }
    },
