            "value": "Sign out? Data on this device will not be deleted."
          }
        }
      }
    },
    "Hesap ve sunucudaki tüm veriler kalıcı olarak silinsin mi? Bu cihazdaki veriler kalır.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap ve sunucudaki tüm veriler kalıcı olarak silinsin mi? Bu cihazdaki veriler kalır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently delete account and all server data? Data on this device will remain."
          }
        }
      }
    },
    "Canlı yazım açıkken cevap, ChatGPT'deki gibi geldikçe ekrana yazılır. Sunucu desteklemiyorsa otomatik olarak normal moda geçilir.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canlı yazım açıkken cevap, ChatGPT'deki gibi geldikçe ekrana yazılır. Sunucu desteklemiyorsa otomatik olarak normal moda geçilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When streaming is on, responses appear in real-time. If the server does not support streaming, it falls back to standard mode."
          }
        }
      }
    },
    "Pufy'ye hoş geldin": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pufy'ye hoş geldin"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to Pufy"
          }
        }
      }
    },
    "Sorularını cevaplayan, web'de araştıran, hatırlatıcı kuran kişisel yapay zeka asistanın. İstediğin yapay zeka modelini bağlayabilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorularını cevaplayan, web'de araştıran, hatırlatıcı kuran kişisel yapay zeka asistanın. İstediğin yapay zeka modelini bağlayabilirsin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your personal AI assistant that answers questions, researches the web, and sets reminders. You can connect any AI model you choose."
          }
        }
      }
    },
    "Seni tanır": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seni tanır"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gets to know you"
          }
        }
      }
    },
    "Konuştukça seninle ilgili önemli şeyleri öğrenir ve kişisel ağında saklar. Gerektiğinde hatırlar, istemediğini silersin.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuştukça seninle ilgili önemli şeyleri öğrenir ve kişisel ağında saklar. Gerektiğinde hatırlar, istemediğini silersin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As you chat, it learns important details about you and stores them in your personal network. It recalls them when needed, and you can delete anything anytime."
          }
        }
      }
    },
    "Uygulamalar": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamalar"
